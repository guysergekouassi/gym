# Configuration pour le PC de la salle (copiée en .env par installer-gymflow.bat)
APP_NAME=GymFlow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8005
APP_TIMEZONE=Africa/Abidjan

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Salle (modifiable ensuite dans Administration → Paramètres)
SALLE_NOM="Gymnase EPIKAÏZO"
SALLE_ADRESSE="Yopougon Maroc, Carrefour Éléphant"
SALLE_TELEPHONE="07 97 41 71 63"
SALLE_TARIF_JOURNALIER=2500
SALLE_TARIF_FIDELITE=2000

# Tickets : navigateur ; rouleau 80 ou 58 mm
RECU_DRIVER=navigateur
RECU_LARGEUR=80
